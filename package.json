{
  "name": "mini-feed",
  "version": "3.0.0",
  "private": true,
  "description": "Mini Feed - 极简社交动态应用（Vue 3 + Pinia + Hono RESTful API，TDD 开发）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "start:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "keywords": [
    "vue3",
    "pinia",
    "hono",
    "rest-api",
    "tdd",
    "vite"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pinia": "^3.0.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.5",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
